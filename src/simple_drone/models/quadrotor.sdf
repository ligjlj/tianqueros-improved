<?xml version="1.0"?>
<sdf version="1.7">
  <model name="quadrotor">
    <!-- Position: start at origin, 1m above ground -->
    <pose>0 0 1.5 0 0 0</pose>

    <!-- Central body -->
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.03</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>

      <!-- Four arms -->
      <visual name="arm_fl">
        <pose>0.15 0.15 0 0 0 0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient></material>
      </visual>
      <visual name="arm_fr">
        <pose>0.15 -0.15 0 0 0 -0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient></material>
      </visual>
      <visual name="arm_bl">
        <pose>-0.15 0.15 0 0 0 -0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient></material>
      </visual>
      <visual name="arm_br">
        <pose>-0.15 -0.15 0 0 0 0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient></material>
      </visual>

      <!-- Four rotors (visual only) -->
      <visual name="rotor_fl">
        <pose>0.22 0.22 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.8 0.1 0.5</ambient></material>
      </visual>
      <visual name="rotor_fr">
        <pose>0.22 -0.22 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.8 0.1 0.5</ambient></material>
      </visual>
      <visual name="rotor_bl">
        <pose>-0.22 0.22 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.8 0.1 0.5</ambient></material>
      </visual>
      <visual name="rotor_br">
        <pose>-0.22 -0.22 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.8 0.1 0.5</ambient></material>
      </visual>
    </link>

    <!-- Ground truth pose for ROS -->
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <bodyName>base_link</bodyName>
      <topicName>drone/ground_truth</topicName>
      <frameName>world</frameName>
      <updateRate>50.0</updateRate>
    </plugin>

    <!-- Force/torque plugin for control -->
    <plugin name="force_control" filename="libgazebo_ros_force.so">
      <bodyName>base_link</bodyName>
      <topicName>drone/force</topicName>
    </plugin>
  </model>
</sdf>
