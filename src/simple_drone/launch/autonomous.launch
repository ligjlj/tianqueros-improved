<launch>
  <!-- Set GAZEBO_MODEL_PATH to find our model -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find simple_drone)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <!-- Launch Gazebo with obstacle world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find simple_drone)/worlds/drone_world.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn the quadrotor -->
  <node name="spawn_quadrotor" pkg="gazebo_ros" type="spawn_model"
        args="-sdf -model quadrotor -file $(find simple_drone)/models/quadrotor.sdf
              -x 0 -y 0 -z 1.5"
        output="screen"/>

  <!-- Autonomous controller -->
  <node name="drone_controller" pkg="simple_drone" type="drone_controller.py"
        output="screen">
    <param name="kp_xy" value="1.5"/>
    <param name="kd_xy" value="0.8"/>
    <param name="kp_z" value="3.0"/>
    <param name="kd_z" value="1.5"/>
    <param name="hover_thrust" value="14.7"/>
  </node>
</launch>
