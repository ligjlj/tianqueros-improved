      <pose>-5 5 0.75 0 0 0</pose>
      <link name="link_p2">
        <collision name="collision_p2">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual_p2">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
          <material><ambient>0.8 0.6 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pillar3">
      <static>true</static>
      <pose>5 -5 0.75 0 0 0</pose>
      <link name="link_p3">
        <collision name="collision_p3">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual_p3">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
          <material><ambient>0.8 0.6 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pillar4">
      <static>true</static>
      <pose>-5 -5 0.75 0 0 0</pose>
      <link name="link_p4">
        <collision name="collision_p4">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual_p4">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
          <material><ambient>0.8 0.6 0.2 1</ambient></material>
