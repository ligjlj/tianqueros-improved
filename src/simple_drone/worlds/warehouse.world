      <pose>-3 0 1.5 0 0 0</pose>
      <link name="link_v2">
        <collision name="collision_v2">
          <geometry><box><size>0.2 8 3</size></box></geometry>
        </collision>
        <visual name="visual_v2">
          <geometry><box><size>0.2 8 3</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pillar1">
      <static>true</static>
      <pose>5 5 0.75 0 0 0</pose>
      <link name="link_p1">
        <collision name="collision_p1">
          <geometry><box><size>0.5 0.5 1.5</size></box></geometry>
