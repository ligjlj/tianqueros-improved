<launch>
  <arg name="config_file" default="$(find warehouse_exploration)/config/exploration.yaml"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <node name="exploration" pkg="warehouse_exploration" type="exploration_node"
        output="screen" respawn="false">
    <rosparam file="$(arg config_file)" command="load"/>
    <param name="inflation_radius_m" value="0.3"/>
    <param name="robot_radius_m" value="0.3"/>
    <remap from="/cmd_vel" to="$(arg cmd_vel_topic)"/>
  </node>
</launch>
