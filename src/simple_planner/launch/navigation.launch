<launch>
  <!-- Cartographer → Map Bridge -->
  <node pkg="simple_planner" type="cartographer_map_bridge.py" name="cartographer_map_bridge"
        output="screen">
    <param name="resolution" value="0.05"/>
    <param name="map_width" value="800"/>
    <param name="map_height" value="800"/>
  </node>

  <!-- A* Global Planner -->
  <node pkg="simple_planner" type="astar_planner.py" name="astar_planner"
        output="screen">
    <param name="robot_radius" value="2"/>
    <param name="heuristic_weight" value="1.0"/>
  </node>

  <!-- DWA Local Planner -->
  <node pkg="simple_planner" type="dwa_planner.py" name="dwa_planner"
        output="screen">
    <param name="max_linear_vel" value="1.0"/>
    <param name="max_angular_vel" value="1.5"/>
    <param name="predict_time" value="1.5"/>
    <param name="robot_radius" value="0.5"/>
    <param name="alpha" value="0.5"/>
    <param name="beta" value="2.0"/>
    <param name="gamma" value="0.3"/>
  </node>
</launch>
