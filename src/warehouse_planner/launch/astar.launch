<launch>
  <!-- A* Global Path Planner -->
  <!-- Requires: /map (OccupancyGrid), /move_base_simple/goal (PoseStamped), TF -->

  <arg name="config_file" default="$(find warehouse_planner)/config/astar.yaml"/>

  <node name="astar_planner" pkg="warehouse_planner" type="astar_planner_node"
        output="screen" respawn="false">
    <rosparam file="$(arg config_file)" command="load"/>
    <param name="inflation_radius_m" value="0.3"/>
    <param name="robot_radius_m" value="0.3"/>
  </node>
</launch>
